        <mxCell id="c2_req" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7DD3FC;fontSize=11;align=left;spacingLeft=10;" value="&lt;b&gt;HTTP Request Message&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0284c7&quot;&gt;&lt;b&gt;• Headers:&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;  Authorization: Bearer [Token]&lt;br/&gt;  Content-Type: application/json&lt;br/&gt;&lt;font color=&quot;#0284c7&quot;&gt;&lt;b&gt;• Body Payload:&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;  JSON String Data" vertex="1">
