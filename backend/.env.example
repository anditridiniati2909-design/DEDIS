APP_NAME="DEDIS - Posyandu Anggrek 4"
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_GENERATE_WITH_ARTISAN
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dedis_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_EXPIRATION_HOURS=168

# Firebase Cloud Messaging (untuk pemicu push notifikasi H-3 & H-1 jadwal posyandu)
FCM_SERVER_KEY=
FCM_SENDER_ID=

# AI Nutrition Assistant (Optional - server proxy only, never on client)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

